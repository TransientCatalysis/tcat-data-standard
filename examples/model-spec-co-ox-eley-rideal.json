{
  "schema_version": "0.1.0",
  "spec_id": "co-ox-4step-eley-rideal",
  "family": "microkinetic",
  "name": "CO oxidation, four-step, direct CO2 release",
  "description": "Seven free rate constants over four steps. The surface reaction releases gas-phase CO2 in one step, so CO2* and its desorption do not exist. Structurally simpler than the LH variants rather than a reparameterisation of them.",
  "derived_from": "art://spec-co-ox-5step-irreversible-45-2026-09-01-000000",
  "derivation": "steps 4 and 5 merged into a single direct-release step; CO2* removed",
  "parameter_transform": "log10",
  "mechanism": {
    "sites": [
      {
        "name": "*",
        "density": 1.0
      }
    ],
    "gas": [
      {
        "name": "CO"
      },
      {
        "name": "O2"
      },
      {
        "name": "CO2"
      }
    ],
    "adsorbates": [
      {
        "name": "CO*",
        "site": "*",
        "composition": {
          "C": 1,
          "O": 1
        }
      },
      {
        "name": "O2*",
        "site": "*",
        "composition": {
          "O": 2
        }
      },
      {
        "name": "O*",
        "site": "*",
        "composition": {
          "O": 1
        }
      }
    ],
    "steps": [
      {
        "equation": "CO + * -> CO*",
        "name": "S1 CO adsorption",
        "reversible": true
      },
      {
        "equation": "O2 + * -> O2*",
        "name": "S2 O2 adsorption",
        "reversible": true
      },
      {
        "equation": "O2* + * -> 2 O*",
        "name": "S3 O2 dissociation",
        "reversible": true
      },
      {
        "equation": "CO* + O* -> CO2 + 2 *",
        "name": "S4 surface reaction with direct release",
        "reversible": false
      }
    ],
    "activity_basis": "mole_fraction",
    "gas_constant_J_per_mol_K": 8.314
  },
  "free_parameters": [
    {
      "name": "k1",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_1",
      "units": "log10(1/s)",
      "bounds": [
        -4.0,
        8.0
      ]
    },
    {
      "name": "k2",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_2",
      "units": "log10(1/s)",
      "bounds": [
        -4.0,
        8.0
      ]
    },
    {
      "name": "k3",
      "units": "log10(1/s)",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_3",
      "units": "log10(1/s)",
      "bounds": [
        -6.0,
        6.0
      ]
    },
    {
      "name": "k4",
      "units": "log10(1/s)",
      "bounds": [
        -2.0,
        9.0
      ]
    }
  ],
  "reaction_system": "CO oxidation",
  "access_status": "public",
  "license": "CC-BY-4.0",
  "notes": "The set's control on network topology rather than on parameter count. Removing CO2* removes a state as well as a constant: seven against the irreversible LH arm's eight, over four steps rather than five."
}
