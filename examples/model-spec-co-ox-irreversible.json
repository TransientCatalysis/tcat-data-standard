{
  "schema_version": "0.2.0",
  "spec_id": "co-ox-5step-irreversible-45",
  "family": "microkinetic",
  "name": "CO oxidation, five-step LH, steps 4 and 5 irreversible",
  "description": "Eight free rate constants. Steps 4 and 5 carry no reverse rate, which is a reasonable approximation when CO2 readsorption is negligible at the conditions of interest.",
  "parameter_transform": "log10",
  "mechanism": {
    "sites": [
      {
        "name": "*",
        "density": 1.0
      }
    ],
    "gas": [
      {
        "name": "CO"
      },
      {
        "name": "O2"
      },
      {
        "name": "CO2"
      }
    ],
    "adsorbates": [
      {
        "name": "CO*",
        "site": "*",
        "composition": {
          "C": 1,
          "O": 1
        }
      },
      {
        "name": "O2*",
        "site": "*",
        "composition": {
          "O": 2
        }
      },
      {
        "name": "O*",
        "site": "*",
        "composition": {
          "O": 1
        }
      },
      {
        "name": "CO2*",
        "site": "*",
        "composition": {
          "C": 1,
          "O": 2
        }
      }
    ],
    "steps": [
      {
        "equation": "CO + * -> CO*",
        "name": "S1 CO adsorption",
        "reversible": true
      },
      {
        "equation": "O2 + * -> O2*",
        "name": "S2 O2 adsorption",
        "reversible": true
      },
      {
        "equation": "O2* + * -> 2 O*",
        "name": "S3 O2 dissociation",
        "reversible": true
      },
      {
        "equation": "CO* + O* -> CO2* + *",
        "name": "S4 surface reaction",
        "reversible": false
      },
      {
        "equation": "CO2* -> CO2 + *",
        "name": "S5 CO2 desorption",
        "reversible": false
      }
    ],
    "activity_basis": "mole_fraction",
    "gas_constant_J_per_mol_K": 8.314
  },
  "free_parameters": [
    {
      "name": "k1",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -8.0,
        8.5
      ]
    },
    {
      "name": "k_1",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    },
    {
      "name": "k2",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -8.0,
        8.5
      ]
    },
    {
      "name": "k_2",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    },
    {
      "name": "k3",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    },
    {
      "name": "k_3",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    },
    {
      "name": "k4",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    },
    {
      "name": "k5",
      "units": "log10(1/s)",
      "bounds": [
        -8.0,
        13.0
      ]
    }
  ],
  "reaction_system": "CO oxidation",
  "access_status": "public",
  "license": "CC-BY-4.0",
  "notes": "One of a PAIR of examples that exist to show mechanism comparison working. Its sibling, co-ox-5step-reversible-closure, describes the same chemistry with steps 4 and 5 reversible and a thermodynamic closure on step 4. Two specifications, two artifact ids, two fits, one comparison -- and no registry entry, no pull request, and no possibility of the two colliding."
}
