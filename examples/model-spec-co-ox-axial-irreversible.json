{
  "schema_version": "0.1.0",
  "spec_id": "co-ox-5step-irrev-axial",
  "family": "microkinetic",
  "name": "CO oxidation, five-step LH, irreversible steps 4-5, axial bed",
  "description": "The eight-constant irreversible network evaluated in a one-dimensional axially-dispersed packed bed. Identical hypothesis to co-ox-5step-irreversible-45 except for where it reacts.",
  "derived_from": "art://spec-co-ox-5step-irreversible-45-2026-09-01-000000",
  "derivation": "same mechanism, evaluated in an axially-dispersed packed bed",
  "parameter_transform": "log10",
  "reactor": {
    "kind": "axially-dispersed-packed-bed",
    "nodes": 21,
    "convection": "upwind2",
    "outlet": "psu",
    "velocity": "psu-variable",
    "dispersion": "edwards-richardson-fuller-wilke",
    "rate_basis": "per-site",
    "inlet_reconstruction": {
      "method": "tracer-shift",
      "tracer": "Ar"
    },
    "notes": "Per-site rates on the mole-fraction basis: constants unit-identical to the gradientless treatment's, so the reactor comparison needs no unit conversion."
  },
  "mechanism": {
    "sites": [
      {
        "name": "*",
        "density": 1.0
      }
    ],
    "gas": [
      {
        "name": "CO"
      },
      {
        "name": "O2"
      },
      {
        "name": "CO2"
      }
    ],
    "adsorbates": [
      {
        "name": "CO*",
        "site": "*",
        "composition": {
          "C": 1,
          "O": 1
        }
      },
      {
        "name": "O2*",
        "site": "*",
        "composition": {
          "O": 2
        }
      },
      {
        "name": "O*",
        "site": "*",
        "composition": {
          "O": 1
        }
      },
      {
        "name": "CO2*",
        "site": "*",
        "composition": {
          "C": 1,
          "O": 2
        }
      }
    ],
    "steps": [
      {
        "equation": "CO + * -> CO*",
        "name": "S1 CO adsorption",
        "reversible": true
      },
      {
        "equation": "O2 + * -> O2*",
        "name": "S2 O2 adsorption",
        "reversible": true
      },
      {
        "equation": "O2* + * -> 2 O*",
        "name": "S3 O2 dissociation",
        "reversible": true
      },
      {
        "equation": "CO* + O* -> CO2* + *",
        "name": "S4 surface reaction",
        "reversible": false
      },
      {
        "equation": "CO2* -> CO2 + *",
        "name": "S5 CO2 desorption",
        "reversible": false
      }
    ],
    "activity_basis": "mole_fraction",
    "gas_constant_J_per_mol_K": 8.314
  },
  "free_parameters": [
    {
      "name": "k1",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_1",
      "units": "log10(1/s)",
      "bounds": [
        -4.0,
        8.0
      ]
    },
    {
      "name": "k2",
      "units": "log10(1/(mol_frac s))",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_2",
      "units": "log10(1/s)",
      "bounds": [
        -4.0,
        8.0
      ]
    },
    {
      "name": "k3",
      "units": "log10(1/s)",
      "bounds": [
        -2.0,
        8.0
      ]
    },
    {
      "name": "k_3",
      "units": "log10(1/s)",
      "bounds": [
        -6.0,
        6.0
      ]
    },
    {
      "name": "k4",
      "units": "log10(1/s)",
      "bounds": [
        -2.0,
        9.0
      ]
    },
    {
      "name": "k5",
      "units": "log10(1/s)",
      "bounds": [
        -2.0,
        9.0
      ]
    }
  ],
  "reaction_system": "CO oxidation",
  "access_status": "public",
  "license": "CC-BY-4.0",
  "notes": "DRAFT (2026-08), axial-PDE branch. The A/B partner of co-ox-5step-irreversible-45: fit both to the same runs and the difference in the constants is the reactor model, attributably."
}
