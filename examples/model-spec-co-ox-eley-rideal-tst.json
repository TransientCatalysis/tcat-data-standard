  "name": "CO oxidation, four-step direct release, TST-anchored joint fit",
  "family": "microkinetic",
  "reaction_system": "CO oxidation",
  "description": "The Eley-Rideal network -- CO2 released directly from CO* + O* with no adsorbed CO2 intermediate -- with prefactors anchored at kT/h or the collision rate and the activation entropy fitted. The competitor to the five-step LH TST fit under the same parameterisation, so the two differ in network and in nothing else.",
  "derived_from": "art://spec-co-ox-4step-eley-rideal-2026-09-01-000000",
  "derivation": "reparameterised in (dS#, dH#, dH_ads, dS_ads) with anchored prefactors; all four steps reversible via detailed balance",
  "parameter_transform": "none",
  "mechanism": {
    "sites": [
      {
        "name": "*",
        "density": 1.0
      }
    ],
    "gas": [
      {
        "name": "CO"
      },
      {
        "name": "O2"
      },
      {
        "name": "CO2"
      }
    ],
    "adsorbates": [
