        "composition": {
          "O": 2
        }
      },
      {
        "name": "O*",
        "site": "*",
        "composition": {
          "O": 1
        }
      }
    ],
    "steps": [
      {
        "equation": "CO + * -> CO*",
        "name": "S1 CO adsorption",
        "reversible": true
      },
      {
        "equation": "O2 + * -> O2*",
        "name": "S2 O2 adsorption",
        "reversible": true
      },
      {
        "equation": "O2* + * -> 2 O*",
        "name": "S3 O2 dissociation",
        "reversible": true
      },
      {
        "equation": "CO* + O* -> CO2 + 2 *",
        "name": "S4 surface reaction with direct release",
        "reversible": true
      }
    ],
    "activity_basis": "mole_fraction",
    "gas_constant_J_per_mol_K": 8.314
  },
  "thermodynamics": {
    "parameterisation": "tst-detailed-balance",
    "gas_parents": {
      "CO*": {
        "CO": 1
      },
      "O2*": {
        "O2": 1
      },
      "O*": {
        "O2": 0.5
      }
    },
    "gas_data_source": "gas-thermo-codata-shomate-2026-08-25",
    "pressure_Pa": 101325.0,
    "notes": "Prefactors are ANCHORED, not fitted. Step 4 makes gas-phase CO2 directly, but its forward side consumes no gas molecule, so it is a surface step at kT/h -- the anchor follows the FORWARD direction, which is the same rule that puts desorption at kT/h in the LH network."
  },
